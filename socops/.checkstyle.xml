<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.1//EN"
    "https://checkstyle.org/dtds/configuration_1_1.dtd">

<module name="Checker">
    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="WhitespaceAround"/>
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyLineSeparator">
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, STATIC_INIT, INSTANCE_INIT, CTOR_DEF, METHOD_DEF, VARIABLE_DEF, RECORD_DEF"/>
        </module>
        <module name="NoWhitespaceBeforeCaseDefaultColon"/>
    </module>
</module>
